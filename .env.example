# ==============================================================================
# Zuber – Environment Configuration Example
# ==============================================================================

# Server Network Port
PORT=3443

# TLS / HTTPS Configuration
# Set to 'false' when operating behind Nginx Proxy Manager (NPM terminates TLS)
# Set to 'true' for standalone HTTPS with self-signed certificate in ./certs/
ENABLE_HTTPS=false

# Reverse Proxy Trust
# Must be 'true' behind Nginx Proxy Manager to read real client IP and HTTPS headers
TRUST_PROXY=true

# Security & Authentication
# FORCE_AUTH=true prevents accidental deactivation of password in public internet
FORCE_AUTH=true
# Primary authentication password (legacy fallbacks: ZUBER_PASSWORD, KNOWMESH_PASSWORD, OBSIDIAN_WEB_PASSWORD)
PASSWORD=zuber-vault-secure-password
SESSION_SECRET=change-me-to-a-secure-random-32-byte-hex-string-in-production

# Persistent Paths
VAULT_DIR=./vault
CONFIG_PATH=./server-config.json

# Limits & CORS
MAX_UPLOAD_MB=100
# ALLOWED_ORIGINS=https://zuber.example.com
